<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.css" rel="stylesheet">
<style>
    .btn-save {
        font-size: 16px;
        padding: 10px 25px;
    }
    .note-editor.note-frame {
        border: 1px solid #ccc;
        border-radius: 4px;
    }
</style>

<div class="row">
    <div class="add-form col-md-11 center-block">
        <div>
            <h1>Vložit aktualitu</h1>
            <form action="" method="post">
                <div class="form-group">
                    <label for="nadpis">Nadpis:</label>
                    <input class="form-control" type="text" id="nadpis" name="nadpis" value=""/>
                </div>
                <div class="form-group">
                    <label for="perex">Perex:</label>
                    <textarea id="perex" name="perex"></textarea>
                </div>
                <div class="form-group">
                    <label for="obsah">Obsah:</label>
                    <textarea id="obsah" name="obsah"></textarea>
                </div>
                <div class="form-group">
                    <label class="checkbox-inline">
                        <input type="checkbox" name="zobrazit" value="ano"/> Zveřejnit
                    </label>
                </div>
                <div class="form-group">
                    <input class="btn btn-primary btn-save pull-right" type="submit" name="ok" value="Uložit"/>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote.min.js"></script>
<script>
$(document).ready(function () {
    $('#perex').summernote({
        height: 150,
        toolbar: [
            ['font',   ['bold', 'italic', 'underline', 'clear']],
            ['para',   ['ul', 'ol']],
            ['insert', ['link']],
            ['view',   ['codeview']]
        ],
        placeholder: 'Krátký úvod aktuality...'
    });
    $('#obsah').summernote({
        height: 400,
        toolbar: [
            ['style',  ['style']],
            ['font',   ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
            ['para',   ['ul', 'ol', 'paragraph']],
            ['table',  ['table']],
            ['insert', ['link', 'hr']],
            ['view',   ['fullscreen', 'codeview']]
        ],
        styleTags: ['p', 'h2', 'h3', 'h4'],
        placeholder: 'Napište obsah aktuality...'
    });
});
</script>
